VITE_API_URL=http://localhost:5000/api

# Backend'deki REQUIRE_EDU_EMAIL ile aynı tutun.
VITE_REQUIRE_EDU_EMAIL=false

# "Continue with Google": mobil uygulamadaki ve backend'deki GOOGLE_CLIENT_IDS ile aynı "Web application" OAuth Client ID.
# Google Cloud Console'da bu client'ın "Authorized JavaScript origins" listesine site adresi eklenmeli. Boşsa buton gizlenir.
VITE_GOOGLE_CLIENT_ID=
