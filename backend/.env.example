PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/notehub

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — frontend origin(leri). Birden fazlaysa virgülle ayırın.
# İlk origin, doğrulama e-postasındaki bağlantı için de kullanılır.
CLIENT_URL=http://localhost:5173

# Özellik anahtarları — bireysel kullanım için kapalı, yayına alırken true yapın.
# REQUIRE_EDU_EMAIL: sadece .edu.tr e-postalarla kayıt
# REQUIRE_EMAIL_VERIFICATION: e-posta doğrulanmadan yükleme/indirme/etkileşim yok
REQUIRE_EDU_EMAIL=false
REQUIRE_EMAIL_VERIFICATION=false

# Dosya yükleme
MAX_FILE_SIZE_MB=25

# E-posta: BREVO_API_KEY doluysa Brevo HTTP API, değilse SMTP kullanılır; ikisi de boşsa doğrulama bağlantısı
# e-posta yerine konsola yazılır (geliştirme için). Render ücretsiz planında SMTP portları kapalı olabilir, Brevo önerilir.
# BREVO_API_KEY: app.brevo.com > SMTP & API > API Keys. MAIL_FROM adresi Brevo > Senders bölümünde onaylanmış olmalı.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SearchNote <no-reply@searchnote.app>"

# Cloudinary — doluysa yeni dosyalar Cloudinary'ye yüklenir, boşsa yerel diske (backend/uploads).
# Cloudinary panelinde "API Keys" sayfasındaki "API environment variable" değeri:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Google ile giriş (mobil uygulama). Google Cloud Console > Credentials > "Web application" tipindeki OAuth Client ID.
# Birden fazlaysa virgülle ayırın. Boşsa /api/auth/google kapalıdır.
GOOGLE_CLIENT_IDS=
