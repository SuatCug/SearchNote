PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/notehub

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — frontend origin(leri). Birden fazlaysa virgülle ayırın.
# İlk origin, doğrulama e-postasındaki bağlantı için de kullanılır.
CLIENT_URL=http://localhost:5173

# Özellik anahtarları — bireysel kullanım için kapalı, yayına alırken true yapın.
# REQUIRE_EDU_EMAIL: sadece .edu.tr e-postalarla kayıt
# REQUIRE_EMAIL_VERIFICATION: e-posta doğrulanmadan yükleme/indirme/etkileşim yok
REQUIRE_EDU_EMAIL=false
REQUIRE_EMAIL_VERIFICATION=false

# Dosya yükleme
MAX_FILE_SIZE_MB=25

# E-posta: BREVO_API_KEY doluysa Brevo HTTP API, değilse SMTP kullanılır; ikisi de boşsa doğrulama bağlantısı
# e-posta yerine konsola yazılır (geliştirme için). Render ücretsiz planında SMTP portları kapalı olabilir, Brevo önerilir.
# BREVO_API_KEY: app.brevo.com > SMTP & API > API Keys. MAIL_FROM adresi Brevo > Senders bölümünde onaylanmış olmalı.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SearchNote <no-reply@searchnote.app>"

# Cloudinary — doluysa yeni dosyalar Cloudinary'ye yüklenir, boşsa yerel diske (backend/uploads).
# Cloudinary panelinde "API Keys" sayfasındaki "API environment variable" değeri:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Google ile giriş (mobil uygulama). Google Cloud Console > Credentials > "Web application" tipindeki OAuth Client ID.
# Birden fazlaysa virgülle ayırın. Boşsa /api/auth/google kapalıdır.
GOOGLE_CLIENT_IDS=

# İletişim formu (Contact) mesajlarının gönderileceği adres. Boşsa mesajlar sadece veritabanına kaydedilir.
CONTACT_INBOX=

# Yapay zekâ (notların içinde soru cevaplama, quiz / flashcard, taranmış notları okuma).
# Boşsa bu özellikler kapalıdır; notların içinde kelime araması yine çalışır.
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# Kullanıcı başına günlük sınırlar (maliyet kontrolü)
AI_DAILY_ASKS=40
AI_DAILY_STUDY_SETS=10
# İsteğe bağlı anlamsal arama (Voyage AI embeddings + Atlas Vector Search). Boşsa sadece kelime araması.
VOYAGE_API_KEY=
# Sunucu açılışında henüz indekslenmemiş notları arka planda işle
AI_INDEX_ON_START=true
# Yerel deneme modu: API anahtarı / kredi olmadan arayüzü denemek için örnek cevap / quiz döner.
# Sadece ANTHROPIC_API_KEY boşken ve NODE_ENV production değilken çalışır. Canlıda (Render) eklemeyin.
AI_MOCK=false
